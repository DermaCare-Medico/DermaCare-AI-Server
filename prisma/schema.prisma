generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: the connection URL lives in prisma.config.ts
datasource db {
  provider = "postgresql"
}

// =========================================
// ENUMS
// =========================================

enum Role {
  PATIENT
  DOCTOR
  ADMIN
  STORE_OWNER

  @@map("user_role")
}

// Account-level status only. Doctor / store approval is tracked on their own tables.
enum AccountStatus {
  ACTIVE
  PENDING
  REJECTED
  SUSPENDED

  @@map("account_status")
}

enum AuthProvider {
  PASSWORD
  GOOGLE

  @@map("auth_provider")
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY

  @@map("gender")
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("otp_purpose")
}

enum RiskCategory {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("risk_category")
}

enum DoctorApprovalStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("doctor_approval_status")
}

enum SlotStatus {
  AVAILABLE
  HELD
  BOOKED
  UNAVAILABLE

  @@map("slot_status")
}

enum AppointmentStatus {
  HELD
  CONFIRMED
  CANCELLATION_REQUESTED
  COMPLETED
  CANCELLED
  NO_SHOW

  @@map("appointment_status")
}

enum ScreeningStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED

  @@map("screening_status")
}

enum ImageQualityStatus {
  GOOD
  POOR
  UNUSABLE

  @@map("image_quality_status")
}

enum ImageType {
  FRONT
  LEFT
  RIGHT
  OTHER

  @@map("image_type")
}

enum ConversationStatus {
  OPEN
  CLOSED

  @@map("conversation_status")
}


enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED

  @@map("order_status")
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED

  @@map("payout_status")
}

enum TransactionStatus {
  PENDING
  PAID
  FAILED
  REFUNDED

  @@map("transaction_status")
}

enum TransactionPurpose {
  APPOINTMENT
  MEDICINE_ORDER

  @@map("transaction_purpose")
}


enum MedicineRequestStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("medicine_request_status")
}

enum NotificationType {
  APPOINTMENT
  PRESCRIPTION
  MESSAGE
  ORDER
  PAYMENT
  ACCOUNT
  SYSTEM

  @@map("notification_type")
}

// =========================================
// 1. USERS AND AUTHENTICATION
// =========================================

model User {
  id            String        @id @default(uuid()) @db.Uuid
  name          String        @db.VarChar(150)
  email         String        @unique @db.VarChar(255)
  phone         String?       @unique @db.VarChar(30)
  role          Role          @default(PATIENT)
  status        AccountStatus @default(ACTIVE)
  emailVerified Boolean       @default(false) @map("email_verified")
  suspendedAt   DateTime?     @map("suspended_at") @db.Timestamp(6)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt     DateTime?     @map("deleted_at") @db.Timestamp(6)

  authIdentities           AuthIdentity[]
  otpCodes                 OtpCode[]
  patientProfile           PatientProfile?
  adminProfile             Admin?
  doctorProfile            DoctorProfile?                @relation("DoctorUser")
  approvedDoctors          DoctorProfile[]               @relation("DoctorApprover")
  verifiedMedicines        Medicine[]                    @relation("MedicineVerifier")
  reviewedMedicineRequests MedicineRequest[]             @relation("MedicineRequestReviewer")
  messages                 Message[]
  notifications            Notification[]
  auditLogs                AuditLog[]

  @@index([role, status])
  @@index([deletedAt])
  @@map("users")
}

model OtpCode {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String?    @map("user_id") @db.Uuid
  email     String     @db.VarChar(255)
  codeHash  String     @map("code_hash") @db.VarChar(255)
  purpose   OtpPurpose
  expiresAt DateTime   @map("expires_at") @db.Timestamp(6)
  attempts  Int        @default(0)
  usedAt    DateTime?  @map("used_at") @db.Timestamp(6)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamp(6)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose, expiresAt])
  @@index([userId])
  @@map("otp_codes")
}

model AuthIdentity {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  provider     AuthProvider
  providerId   String       @map("provider_user_id") @db.VarChar(255)
  passwordHash String?      @map("password_hash") @db.VarChar(255)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@unique([userId, provider]) // also serves as the userId index
  @@map("auth_identities")
}

// =========================================
// 2. PATIENT PROFILE
// =========================================

model PatientProfile {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @unique @map("user_id") @db.Uuid
  dateOfBirth        DateTime? @map("date_of_birth") @db.Date
  gender             Gender?
  address            String?
  allergies          String[]  @default([])
  existingConditions String[]  @default([]) @map("existing_conditions")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  appointments       Appointment[]
  screenings         Screening[]
  conversations      Conversation[]
  currentMedications CurrentMedication[]
  orders             Order[]
  payments           PaymentTransaction[]
  reviews            DoctorReview[]

  @@map("patient_profiles")
}

// =========================================
// 3. ADMIN
// =========================================

model Admin {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("admin")
}

// =========================================
// 4. SPECIALIZATIONS
// =========================================

model Specialization {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(150)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  doctors    DoctorProfile[]
  conditions Condition[]

  @@map("specializations")
}

// =========================================
// 5. DOCTOR PROFILE
// =========================================

model DoctorProfile {
  id               String               @id @default(uuid()) @db.Uuid
  userId           String               @unique @map("user_id") @db.Uuid
  specializationId String               @map("specialization_id") @db.Uuid
  licenseNumber    String               @unique @map("license_number") @db.VarChar(100)
  qualifications   String[]             @default([])
  experienceYears  Int                  @default(0) @map("experience_years")
  consultationFee  Decimal              @map("consultation_fee") @db.Decimal(10, 2)
  bio              String?
  approvalStatus  DoctorApprovalStatus @default(PENDING) @map("approval_status")
  approvedById    String?              @map("approved_by") @db.Uuid
  approvedAt      DateTime?            @map("approved_at") @db.Timestamp(6)
  rejectionReason String?              @map("rejection_reason")
  rating      Decimal? @db.Decimal(3, 2)
  ratingCount Int      @default(0) @map("rating_count")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  user           User           @relation("DoctorUser", fields: [userId], references: [id], onDelete: Restrict)
  specialization Specialization @relation(fields: [specializationId], references: [id], onDelete: Restrict)
  approvedBy     User?          @relation("DoctorApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  slots                 DoctorSlot[]
  appointments          Appointment[]
  prescriptions         Prescription[]
  conversations         Conversation[]
  medicineRequests      MedicineRequest[]
  payouts               DoctorPayout[]
  reviews               DoctorReview[]

  @@index([specializationId])
  @@index([approvalStatus])
  @@map("doctor_profiles")
}

// =========================================
// 7. DOCTOR SLOTS
// Overlap prevention + CHECK(end_time > start_time) are in the SQL migration
// =========================================

model DoctorSlot {
  id        String     @id @default(uuid()) @db.Uuid
  doctorId  String     @map("doctor_id") @db.Uuid
  startTime DateTime   @map("start_time") @db.Timestamp(6)
  endTime   DateTime   @map("end_time") @db.Timestamp(6)
  status    SlotStatus @default(AVAILABLE)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamp(6)

  doctor       DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  appointments Appointment[]

  // Target for the composite FK from appointments (keeps slot and doctor consistent)
  @@unique([id, doctorId])
  @@index([doctorId, startTime])
  @@index([doctorId, status, startTime])
  @@map("doctor_slots")
}

// =========================================
// 8. SCREENINGS
// =========================================

model Screening {
  id                 String              @id @default(uuid()) @db.Uuid
  patientId          String              @map("patient_id") @db.Uuid
  symptoms           String?
  imageQualityStatus ImageQualityStatus? @map("image_quality_status")
  riskLevel          RiskCategory?      @map("risk_level")
  redFlagDetected    Boolean             @default(false) @map("red_flag_detected")
  aiStatus           ScreeningStatus     @default(PENDING) @map("ai_status")
  disclaimer         String?
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamp(6)

  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Restrict)

  images       ScreeningImage[]
  predictions  ScreeningPrediction[]
  appointments Appointment[]

  @@index([patientId, createdAt])
  @@map("screenings")
}

model ScreeningImage {
  id          String    @id @default(uuid()) @db.Uuid
  screeningId String    @map("screening_id") @db.Uuid
  storageKey  String    @map("storage_key")
  imageType   ImageType @default(OTHER) @map("image_type")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  screening Screening @relation(fields: [screeningId], references: [id], onDelete: Cascade)

  @@index([screeningId])
  @@map("screening_images")
}

// =========================================
// 9. CONDITIONS
// =========================================

model Condition {
  id               String       @id @default(uuid()) @db.Uuid
  specializationId String?      @map("specialization_id") @db.Uuid
  name             String       @unique @db.VarChar(150)
  overview         String
  symptoms         String[]     @default([])
  naturalCare      String?      @map("natural_care")
  warningSigns     String[]     @default([]) @map("warning_signs")
  prevention       String?
  riskCategory     RiskCategory @map("risk_category")
  safeForHomeCare  Boolean      @default(false) @map("safe_for_home_care")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamp(6)

  specialization Specialization? @relation(fields: [specializationId], references: [id], onDelete: SetNull)

  predictions ScreeningPrediction[]

  @@index([specializationId])
  @@index([riskCategory])
  @@map("conditions")
}

model ScreeningPrediction {
  id              String   @id @default(uuid()) @db.Uuid
  screeningId     String   @map("screening_id") @db.Uuid
  conditionId     String   @map("condition_id") @db.Uuid
  // Percentage 0-100 (CHECK in SQL migration)
  confidenceScore Decimal  @map("confidence_score") @db.Decimal(5, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  screening Screening @relation(fields: [screeningId], references: [id], onDelete: Cascade)
  condition Condition @relation(fields: [conditionId], references: [id], onDelete: Restrict)

  @@unique([screeningId, conditionId])
  @@index([conditionId])
  @@map("screening_predictions")
}

// =========================================
// 10. APPOINTMENTS
// One ACTIVE appointment per slot is enforced by a partial unique index (SQL migration)
// =========================================

model Appointment {
  id                      String            @id @default(uuid()) @db.Uuid
  patientId               String            @map("patient_id") @db.Uuid
  doctorId                String            @map("doctor_id") @db.Uuid
  slotId                  String            @map("slot_id") @db.Uuid
  screeningId             String?           @map("screening_id") @db.Uuid
  status                  AppointmentStatus @default(HELD)
  videoLink               String?           @map("video_link")
  historySharingConsent   Boolean           @default(false) @map("history_sharing_consent")
  cancellationReason      String?           @map("cancellation_reason")
  cancellationRequestedAt DateTime?         @map("cancellation_requested_at") @db.Timestamp(6)
  holdExpiresAt           DateTime?         @map("hold_expires_at") @db.Timestamp(6)
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt               DateTime          @updatedAt @map("updated_at") @db.Timestamp(6)

  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor    DoctorProfile  @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  // Composite FK: the slot must belong to the same doctor
  slot      DoctorSlot     @relation(fields: [slotId, doctorId], references: [id, doctorId], onDelete: Restrict)
  screening Screening?     @relation(fields: [screeningId], references: [id], onDelete: SetNull)

  prescription Prescription?
  conversation Conversation?
  review       DoctorReview?
  payoutItem   DoctorPayoutItem?
  payments     PaymentTransaction[]

  @@index([slotId])
  @@index([patientId, status])
  @@index([doctorId, status])
  @@index([status, holdExpiresAt])
  @@map("appointments")
}

// =========================================
// 11. PRESCRIPTIONS
// =========================================

model Prescription {
  id            String    @id @default(uuid()) @db.Uuid
  appointmentId String    @unique @map("appointment_id") @db.Uuid
  doctorId      String    @map("doctor_id") @db.Uuid
  findings      String?
  advice        String?
  followUp      String?   @map("follow_up")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  sentAt        DateTime? @map("sent_at") @db.Timestamp(6)

  appointment Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  doctor      DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  items  PrescriptionItem[]
  orders Order[]

  @@index([doctorId])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String  @id @default(uuid()) @db.Uuid
  prescriptionId String  @map("prescription_id") @db.Uuid
  medicineId     String  @map("medicine_id") @db.Uuid
  medicineName   String  @map("medicine_name") @db.VarChar(255)
  dosage         String  @db.VarChar(100)
  frequency      String  @db.VarChar(100)
  duration       String  @db.VarChar(100)
  instructions   String?

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine     Medicine     @relation(fields: [medicineId], references: [id], onDelete: Restrict)

  @@index([prescriptionId])
  @@index([medicineId])
  @@map("prescription_items")
}

// =========================================
// 12. CONVERSATIONS AND MESSAGES
// =========================================

model Conversation {
  id            String             @id @default(uuid()) @db.Uuid
  appointmentId String             @unique @map("appointment_id") @db.Uuid
  patientId     String             @map("patient_id") @db.Uuid
  doctorId      String             @map("doctor_id") @db.Uuid
  status        ConversationStatus @default(OPEN)
  openedAt      DateTime           @default(now()) @map("opened_at") @db.Timestamp(6)
  closesAt      DateTime?          @map("closes_at") @db.Timestamp(6)
  closedAt      DateTime?          @map("closed_at") @db.Timestamp(6)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamp(6)

  appointment Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  patient     PatientProfile @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor      DoctorProfile  @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  messages Message[]

  @@index([patientId])
  @@index([doctorId])
  @@index([status, closesAt])
  @@map("conversations")
}

model Message {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  senderId       String    @map("sender_id") @db.Uuid
  messageText    String    @map("message_text")
  sentAt         DateTime  @default(now()) @map("sent_at") @db.Timestamp(6)
  readAt         DateTime? @map("read_at") @db.Timestamp(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  // Must be the patient's or doctor's user (trigger in SQL migration)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([conversationId, sentAt])
  @@index([senderId])
  @@map("messages")
}

// =========================================
// 13. CURRENT MEDICATIONS
// =========================================

model CurrentMedication {
  id           String    @id @default(uuid()) @db.Uuid
  patientId    String    @map("patient_id") @db.Uuid
  medicineName String    @map("medicine_name") @db.VarChar(200)
  dosage       String?   @db.VarChar(100)
  frequency    String?   @db.VarChar(100)
  startDate    DateTime? @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  notes        String?
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId, isActive])
  @@map("current_medications")
}

// =========================================
// 14. STORES, MEDICINES, INVENTORY
// =========================================
model Medicine {
  id                   String    @id @default(uuid()) @db.Uuid
  name                 String    @db.VarChar(200)
  verifiedById         String?   @map("verified_by") @db.Uuid
  description          String?
  requiresPrescription Boolean   @default(false) @map("requires_prescription")
  isVerified           Boolean   @default(false) @map("is_verified")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  verifiedAt           DateTime? @map("verified_at") @db.Timestamp(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  verifiedBy User? @relation("MedicineVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  inventory         StoreInventory[]
  prescriptionItems PrescriptionItem[]

  @@index([name])
  @@index([isVerified])
  @@map("medicines")
}

model MedicineRequest {
  id              String                @id @default(uuid()) @db.Uuid
  requestedById   String                @map("requested_by") @db.Uuid
  medicineName    String                @map("medicine_name") @db.VarChar(255)
  genericName     String?               @map("generic_name") @db.VarChar(255)
  strength        String?               @db.VarChar(100)
  dosageForm      String?               @map("dosage_form") @db.VarChar(100)
  manufacturer    String?               @db.VarChar(255)
  description     String?
  status          MedicineRequestStatus @default(PENDING)
  reviewedById    String?               @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?             @map("reviewed_at") @db.Timestamp(6)
  rejectionReason String?               @map("rejection_reason")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamp(6)

  requestedBy DoctorProfile @relation(fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy  User?         @relation("MedicineRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([requestedById])
  @@map("medicine_requests")
}

model StoreInventory {
 id            String   @id @default(uuid()) @db.Uuid
  medicineId    String   @unique @map("medicine_id") @db.Uuid
  price         Decimal  @db.Decimal(10, 2)
  stockQuantity Int      @default(0) @map("stock_quantity")
  isAvailable   Boolean  @default(true) @map("is_available")
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Restrict)

  orderItems OrderItem[]

  @@map("store_inventory")
}

// =========================================
// 15. ORDERS
// =========================================

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  patientId       String      @map("patient_id") @db.Uuid
  prescriptionId  String?     @map("prescription_id") @db.Uuid
  status          OrderStatus @default(PENDING)
  totalAmount     Decimal     @map("total_amount") @db.Decimal(10, 2)
  deliveryAddress String      @map("delivery_address")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamp(6)

  patient      PatientProfile @relation(fields: [patientId], references: [id], onDelete: Restrict)
  prescription Prescription?  @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)

  items    OrderItem[]
  payments PaymentTransaction[]

  @@index([patientId, createdAt])
  @@index([status])
  @@index([prescriptionId])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(uuid()) @db.Uuid
  orderId      String  @map("order_id") @db.Uuid
  inventoryId  String  @map("inventory_id") @db.Uuid
  medicineName String  @map("medicine_name") @db.VarChar(200)
  quantity     Int
  unitPrice    Decimal @map("unit_price") @db.Decimal(10, 2)
  subtotal     Decimal @db.Decimal(10, 2)

  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inventory StoreInventory @relation(fields: [inventoryId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([inventoryId])
  @@map("order_items")
}

// =========================================
// 16. PAYMENTS AND REFUNDS
// Exactly-one-of(appointment_id, order_id) CHECK is in the SQL migration
// =========================================

model PaymentTransaction {
  id                    String             @id @default(uuid()) @db.Uuid
  patientId             String             @map("patient_id") @db.Uuid
  appointmentId         String?            @map("appointment_id") @db.Uuid
  orderId               String?            @map("order_id") @db.Uuid
  purpose               TransactionPurpose
  amount                Decimal            @db.Decimal(10, 2)
  currency              String             @default("BDT") @db.VarChar(3)
  status                TransactionStatus  @default(PENDING)
  provider              String?            @db.VarChar(50)
  providerTransactionId String?            @unique @map("provider_transaction_id") @db.VarChar(255)
  paidAt                DateTime?          @map("paid_at") @db.Timestamp(6)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamp(6)

  patient     PatientProfile @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  order       Order?         @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([patientId, createdAt])
  @@index([appointmentId])
  @@index([orderId])
  @@index([status])
  @@map("payment_transactions")
}

// =========================================
// 17. DOCTOR PAYOUTS
// =========================================

model DoctorPayout {
  id                 String       @id @default(uuid()) @db.Uuid
  doctorId           String       @map("doctor_id") @db.Uuid
  periodStart        DateTime     @map("period_start") @db.Date
  periodEnd          DateTime     @map("period_end") @db.Date
  totalConsultations Int          @default(0) @map("total_consultations")
  grossAmount        Decimal      @map("gross_amount") @db.Decimal(10, 2)
  platformFee        Decimal      @default(0) @map("platform_fee") @db.Decimal(10, 2)
  netAmount          Decimal      @map("net_amount") @db.Decimal(10, 2)
  status             PayoutStatus @default(PENDING)
  paidAt             DateTime?    @map("paid_at") @db.Timestamp(6)
  transactionReference String?    @map("transaction_reference") @db.VarChar(255)
  notes              String?
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamp(6)

  doctor DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  items DoctorPayoutItem[]

  @@unique([doctorId, periodStart, periodEnd])
  @@index([status])
  @@map("doctor_payouts")
}

model DoctorPayoutItem {
  id                 String   @id @default(uuid()) @db.Uuid
  payoutId           String   @map("payout_id") @db.Uuid
  appointmentId      String   @unique @map("appointment_id") @db.Uuid
  consultationAmount Decimal  @map("consultation_amount") @db.Decimal(10, 2)
  platformFee        Decimal  @default(0) @map("platform_fee") @db.Decimal(10, 2)
  doctorAmount       Decimal  @map("doctor_amount") @db.Decimal(10, 2)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  payout      DoctorPayout @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  appointment Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  @@index([payoutId])
  @@map("doctor_payout_items")
}

// =========================================
// 18. DOCTOR REVIEWS
// rating BETWEEN 1 AND 5 CHECK is in the SQL migration
// =========================================

model DoctorReview {
  id            String    @id @default(uuid()) @db.Uuid
  appointmentId String    @unique @map("appointment_id") @db.Uuid
  patientId     String    @map("patient_id") @db.Uuid
  doctorId      String    @map("doctor_id") @db.Uuid
  rating        Int
  reviewText    String?   @map("review_text")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  appointment Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  patient     PatientProfile @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor      DoctorProfile  @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  @@index([doctorId, createdAt])
  @@index([patientId])
  @@map("doctor_reviews")
}

// =========================================
// 19. NOTIFICATIONS
// =========================================

model Notification {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  title             String           @db.VarChar(200)
  message           String
  notificationType  NotificationType @default(SYSTEM) @map("notification_type")
  relatedEntityType String?          @map("related_entity_type") @db.VarChar(50)
  relatedEntityId   String?          @map("related_entity_id") @db.Uuid
  isRead            Boolean          @default(false) @map("is_read")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

// =========================================
// 20. AUDIT LOGS
// =========================================

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(100)
  entityId    String?  @map("entity_id") @db.Uuid
  before      Json?
  after       Json?
  metadata    Json?
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

