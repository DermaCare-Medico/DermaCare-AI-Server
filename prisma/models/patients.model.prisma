model PatientProfile {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @unique @map("user_id") @db.Uuid
  dateOfBirth        DateTime? @map("date_of_birth") @db.Date
  gender             Gender?
  address            String?
  allergies          String[]  @default([])
  existingConditions String[]  @default([]) @map("existing_conditions")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  appointments       Appointment[]
  screenings         Screening[]
  conversations      Conversation[]
  currentMedications CurrentMedication[]
  orders             Order[]
  payments           PaymentTransaction[]
  reviews            DoctorReview[]

  @@map("patient_profiles")
}

model CurrentMedication {
  id           String    @id @default(uuid()) @db.Uuid
  patientId    String    @map("patient_id") @db.Uuid
  medicineName String    @map("medicine_name") @db.VarChar(200)
  dosage       String?   @db.VarChar(100)
  frequency    String?   @db.VarChar(100)
  startDate    DateTime? @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  notes        String?
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)

  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId, isActive])
  @@map("current_medications")
}