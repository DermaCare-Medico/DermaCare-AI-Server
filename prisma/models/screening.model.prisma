model Screening {
  id                 String              @id @default(uuid()) @db.Uuid
  patientId          String              @map("patient_id") @db.Uuid
  symptoms           String?
  imageQualityStatus ImageQualityStatus? @map("image_quality_status")
  riskLevel          RiskCategory?       @map("risk_level")
  redFlagDetected    Boolean             @default(false) @map("red_flag_detected")
  aiStatus           ScreeningStatus     @default(PENDING) @map("ai_status")
  disclaimer         String?
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamp(6)

  patient      PatientProfile        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointments Appointment[]
  images       ScreeningImage[]
  predictions  ScreeningPrediction[]

  @@index([patientId, createdAt])
  @@map("screenings")
}

model ScreeningImage {
  id          String    @id @default(uuid()) @db.Uuid
  screeningId String    @map("screening_id") @db.Uuid
  storageKey  String    @map("storage_key")
  imageType   ImageType @default(OTHER) @map("image_type")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  screening   Screening @relation(fields: [screeningId], references: [id], onDelete: Cascade)

  @@index([screeningId])
  @@map("screening_images")
}

model Condition {
  id               String                @id @default(uuid()) @db.Uuid
  specializationId String?               @map("specialization_id") @db.Uuid
  name             String                @unique @db.VarChar(150)
  overview         String
  symptoms         String[]              @default([])
  naturalCare      String?               @map("natural_care")
  warningSigns     String[]              @default([]) @map("warning_signs")
  prevention       String?
  riskCategory     RiskCategory          @map("risk_category")
  safeForHomeCare  Boolean               @default(false) @map("safe_for_home_care")
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamp(6)
  specialization   Specialization?       @relation(fields: [specializationId], references: [id])
  predictions      ScreeningPrediction[]

  @@index([specializationId])
  @@index([riskCategory])
  @@map("conditions")
}

model ScreeningPrediction {
  id              String    @id @default(uuid()) @db.Uuid
  screeningId     String    @map("screening_id") @db.Uuid
  conditionId     String    @map("condition_id") @db.Uuid
  confidenceScore Decimal   @map("confidence_score") @db.Decimal(5, 2)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  condition       Condition @relation(fields: [conditionId], references: [id])
  screening       Screening @relation(fields: [screeningId], references: [id], onDelete: Cascade)

  @@unique([screeningId, conditionId])
  @@index([conditionId])
  @@map("screening_predictions")
}