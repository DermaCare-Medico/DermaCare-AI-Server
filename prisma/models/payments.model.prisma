model PaymentTransaction {
  id                    String             @id @default(uuid()) @db.Uuid
  patientId             String             @map("patient_id") @db.Uuid
  appointmentId         String?            @map("appointment_id") @db.Uuid
  orderId               String?            @map("order_id") @db.Uuid
  purpose               TransactionPurpose
  amount                Decimal            @db.Decimal(10, 2)
  currency              String             @default("BDT") @db.VarChar(3)
  status                TransactionStatus  @default(PENDING)
  provider              String?            @db.VarChar(50)
  providerTransactionId String?            @unique @map("provider_transaction_id") @db.VarChar(255)
  stripePaymentIntentId String?            @unique @map("stripe_payment_intent_id") @db.VarChar(255)
  stripeChargeId        String?            @map("stripe_charge_id") @db.VarChar(255)
  stripeRefundId        String?            @unique @map("stripe_refund_id") @db.VarChar(255)
  refundStatus          RefundStatus?      @map("refund_status")
  refundError           String?            @map("refund_error") @db.VarChar(500)
  refundedAt            DateTime?          @map("refunded_at") @db.Timestamp(6)
  paidAt                DateTime?          @map("paid_at") @db.Timestamp(6)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamp(6)

  patient     PatientProfile @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  order       Order?         @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([patientId, createdAt])
  @@index([appointmentId])
  @@index([orderId])
  @@index([status])
  @@index([refundStatus])
  @@map("payment_transactions")
}
