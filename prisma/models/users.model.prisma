model User {
  id                       String            @id @default(uuid()) @db.Uuid
  name                     String            @db.VarChar(150)
  email                    String            @unique @db.VarChar(255)
  phone                    String?           @unique @db.VarChar(30)
  role                     Role              @default(PATIENT)
  status                   AccountStatus     @default(ACTIVE)
  emailVerified            Boolean           @default(false) @map("email_verified")
  suspendedAt              DateTime?         @map("suspended_at") @db.Timestamp(6)
  createdAt                DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt                DateTime          @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt                DateTime?         @map("deleted_at") @db.Timestamp(6)
  consentVersion           String?           @map("consent_version") @db.VarChar(20)
  healthConsentAcceptedAt  DateTime?         @map("health_consent_accepted_at") @db.Timestamp(6)
  privacyAcceptedAt        DateTime?         @map("privacy_accepted_at") @db.Timestamp(6)
  termsAcceptedAt          DateTime?         @map("terms_accepted_at") @db.Timestamp(6)
  adminProfile             Admin?
  auditLogs                AuditLog[]
  authIdentities           AuthIdentity[]
  approvedDoctors          DoctorProfile[]   @relation("DoctorApprover")
  doctorProfile            DoctorProfile?    @relation("DoctorUser")
  reviewedMedicineRequests MedicineRequest[] @relation("MedicineRequestReviewer")
  verifiedMedicines        Medicine[]        @relation("MedicineVerifier")
  messages                 Message[]
  notifications            Notification[]
  patientProfile           PatientProfile?
  refreshTokens            RefreshToken[]

  @@index([role, status])
  @@index([deletedAt])
  @@map("users")
}
