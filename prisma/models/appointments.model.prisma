model Appointment {
  id                      String               @id @default(uuid()) @db.Uuid
  patientId               String               @map("patient_id") @db.Uuid
  doctorId                String               @map("doctor_id") @db.Uuid
  slotId                  String               @unique(map: "appointments_one_active_per_slot", where: raw("(status <> 'CANCELLED'::appointment_status)")) @map("slot_id") @db.Uuid
  screeningId             String?              @map("screening_id") @db.Uuid
  status                  AppointmentStatus    @default(HELD)
  videoLink               String?              @map("video_link")
  historySharingConsent   Boolean              @default(false) @map("history_sharing_consent")
  cancellationReason      String?              @map("cancellation_reason")
  cancellationRequestedAt DateTime?            @map("cancellation_requested_at") @db.Timestamp(6)
  holdExpiresAt           DateTime?            @map("hold_expires_at") @db.Timestamp(6)
  createdAt               DateTime             @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt               DateTime             @updatedAt @map("updated_at") @db.Timestamp(6)
  doctor                  DoctorProfile        @relation(fields: [doctorId], references: [id])
  patient                 PatientProfile       @relation(fields: [patientId], references: [id])
  screening               Screening?           @relation(fields: [screeningId], references: [id])
  slot                    DoctorSlot           @relation(fields: [slotId, doctorId], references: [id, doctorId])
  conversation            Conversation?
  payoutItem              DoctorPayoutItem?
  review                  DoctorReview?
  payments                PaymentTransaction[]
  prescription            Prescription?

  @@index([slotId])
  @@index([patientId, status])
  @@index([doctorId, status])
  @@index([status, holdExpiresAt])
  @@map("appointments")
}
