model Order {
  id              String      @id @default(uuid()) @db.Uuid
  patientId       String      @map("patient_id") @db.Uuid
  prescriptionId  String?     @map("prescription_id") @db.Uuid
  status          OrderStatus @default(PENDING)
  totalAmount     Decimal     @map("total_amount") @db.Decimal(10, 2)
  deliveryAddress String      @map("delivery_address")
  paymentExpiresAt DateTime   @map("payment_expires_at") @db.Timestamp(6)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamp(6)

  patient      PatientProfile @relation(fields: [patientId], references: [id], onDelete: Restrict)
  prescription Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)

  items    OrderItem[]
  payments PaymentTransaction[]

  @@index([patientId, createdAt])
  @@index([status])
  @@index([status, paymentExpiresAt])
  @@index([prescriptionId])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(uuid()) @db.Uuid
  orderId      String  @map("order_id") @db.Uuid
  inventoryId  String  @map("inventory_id") @db.Uuid
  medicineName String  @map("medicine_name") @db.VarChar(200)
  medicineStrength String? @map("medicine_strength") @db.VarChar(100)
  quantity     Int
  unitPrice    Decimal @map("unit_price") @db.Decimal(10, 2)
  subtotal     Decimal @db.Decimal(10, 2)

  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inventory StoreInventory @relation(fields: [inventoryId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([inventoryId])
  @@map("order_items")
}
