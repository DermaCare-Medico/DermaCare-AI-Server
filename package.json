{
  "name": "dermacare-ai-api-docs",
  "version": "1.0.0",
  "type": "module",
  "description": "DermaCare AI — Premium Swagger / OpenAPI 3.0 Documentation Portal",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test:orders": "tsx --test src/modules/orders/services/*.test.ts",
    "test:auth:integration": "tsx --test src/modules/auth/services/auth-otp.integration.test.ts",
    "test:payments:integration": "tsx --test src/modules/payments/services/payments-orders.integration.test.ts",
    "test:meetings": "tsx --test src/integrations/google-calendar/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "seed:screening-conditions": "tsx prisma/seeds/screening-conditions.seed.ts",
    "seed:screening-specializations": "tsx prisma/seeds/screening-specializations.seed.ts"
  },
  "keywords": [
    "dermacare",
    "openapi",
    "swagger",
    "healthcare-api",
    "developer-portal"
  ],
  "author": "DermaCare AI Engineering",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.3.1",
    "googleapis": "^187.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.2",
    "onnxruntime-node": "^1.30.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^8.0.2",
    "@types/swagger-ui-express": "^4.1.7",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
