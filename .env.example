DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

NODE_ENV=development

# JWT
JWT_ACCESS_SECRET=PASTE_FIRST_GENERATED_SECRET_HERE
JWT_ACCESS_EXPIRES_IN=15m

# OTP
OTP_SECRET=PASTE_SECOND_GENERATED_SECRET_HERE

CORS_ORIGIN= corse origin

# Google authentication (optional for now)
GOOGLE_CLIENT_ID=

# { Alternative SMTP configuration (optional)
# Used when Gmail OAuth2 is not configured.
# SMTP email configuration (blank for now, will be used in the future)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM= 
# }

EMAIL_GOOGLE_USER=your-gmail@gmail.com
EMAIL_GOOGLE_CLIENT_ID=your_new_client_id
EMAIL_GOOGLE_CLIENT_SECRET=your_new_client_secret
EMAIL_GOOGLE_REFRESH_TOKEN=your_refresh_token