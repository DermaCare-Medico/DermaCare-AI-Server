# Database: In production with Neon, use the pooled connection string (-pooler suffix) with ?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@ep-xyz-pooler.region.neon.tech:5432/DATABASE?sslmode=require"

NODE_ENV=development

# Store
LOW_STOCK_THRESHOLD=10

# JWT
JWT_ACCESS_SECRET=PASTE_FIRST_GENERATED_SECRET_HERE
JWT_ACCESS_EXPIRES_IN=15m

# OTP
OTP_SECRET=PASTE_SECOND_GENERATED_SECRET_HERE

# CORS
CORS_ORIGIN=http://localhost:3000
CLIENT_URL=http://localhost:3000

# Stripe Hosted Checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ALLOW_DEMO_PAYMENTS=false

# Google Login
GOOGLE_CLIENT_ID=

# Email — Gmail OAuth2
EMAIL_GOOGLE_USER=your-gmail@gmail.com
EMAIL_GOOGLE_CLIENT_ID=your_new_client_id
EMAIL_GOOGLE_CLIENT_SECRET=your_new_client_secret
EMAIL_GOOGLE_REFRESH_TOKEN=your_refresh_token

# Cloudinary configuration (optional for now)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret 
# Email — Alternative SMTP
# Configure these if SMTP is used instead of Gmail OAuth2
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Google Calendar / Meet Integration
GOOGLE_CALENDAR_CLIENT_ID=YOUR_CLIENT_ID
GOOGLE_CALENDAR_CLIENT_SECRET=YOUR_CLIENT_SECRET
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:4000/oauth2callback
GOOGLE_CALENDAR_REFRESH_TOKEN=YOUR_GENERATED_REFRESH_TOKEN
GOOGLE_CALENDAR_ID=primary
